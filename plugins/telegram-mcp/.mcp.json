{
  "mcpServers": {
    "jarvis-telegram-mcp": {
      "command": "python",
      "args": ["server.py"],
      "cwd": ".",
      "env_vars": [
        "LOCALAPPDATA",
        "JARVIS_TELEGRAM_HOME",
        "TG_API_ID",
        "TG_API_HASH",
        "TG_SESSION_PATH"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 120
    }
  }
}
